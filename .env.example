# Copy to .env (git-ignored) and keep ONE of the options below uncommented.
# Read by ./scripts/start-dev.sh, by services started from the project root, and by docker compose.

# --- Required: shared service token ------------------------------------------
# The agents and MCP servers only accept calls carrying this token, so nobody can call them directly and skip the
# traveller's confirmation. Generate one with: openssl rand -hex 32
# (./scripts/start-dev.sh generates one for you if it is not set.)
INTERNAL_API_TOKEN=

# Guardrails (defaults are fine):
#   GUARDRAIL_MAX_INPUT_CHARS  longest accepted message (orchestrator 2000, agents 4000)
#   RATE_LIMIT_PER_MINUTE      chat/plan requests per client IP per minute (default 20)

# Timeouts (defaults are fine for hosted models):
#   OPENAI_TIMEOUT          one LLM call (default 120s)
#   AGENT_TIMEOUT_SECONDS   one agent task, i.e. all its LLM and tool calls (default 300)

# --- Option 1: OpenAI -------------------------------------------------------
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5-mini

# --- Option 2: local model with LM Studio (no key needed) --------------------
# Load a model that supports tool calling, then: Developer > Start Server (port 1234)
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=lm-studio
# OPENAI_MODEL=qwen/qwen3-14b
# OPENAI_TIMEOUT=10m
# AGENT_TIMEOUT_SECONDS=900

# --- Option 3: local model with Ollama (no key needed) -----------------------
# ollama pull qwen3:14b   (any model with the "tools" capability)
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3:14b
# OPENAI_TIMEOUT=10m
# AGENT_TIMEOUT_SECONDS=900

# With docker compose, containers reach a local model on your machine through
# host.docker.internal, e.g. OPENAI_BASE_URL=http://host.docker.internal:1234/v1
